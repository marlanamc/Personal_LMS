{
  "name": "class-companion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-env.mjs && npm run check:nullable-upserts",
    "build": "prisma generate && next build",
    "deploy": "POSTGRES_URL=${POSTGRES_URL:-$DATABASE_URL}; POSTGRES_URL=${POSTGRES_URL:-$STORAGE_POSTGRES_URL}; POSTGRES_URL=${POSTGRES_URL:-$STORAGE_PRISMA_DATABASE_URL}; export POSTGRES_URL; prisma migrate deploy && npm run db:seed:base && next build",
    "postinstall": "POSTGRES_URL=${POSTGRES_URL:-$DATABASE_URL}; POSTGRES_URL=${POSTGRES_URL:-$STORAGE_POSTGRES_URL}; POSTGRES_URL=${POSTGRES_URL:-$STORAGE_PRISMA_DATABASE_URL}; export POSTGRES_URL; prisma generate",
    "start": "next start",
    "analyze": "ANALYZE=true next build",
    "analyze:server": "BUNDLE_ANALYZE=server ANALYZE=true next build",
    "analyze:browser": "BUNDLE_ANALYZE=browser ANALYZE=true next build",
    "test:gamification": "node --import tsx scripts/tests/gamification-helpers.test.ts",
    "test:activity-submit": "node --import tsx scripts/tests/activity-submit-assignmentid.test.ts",
    "lint": "eslint",
    "audit:diagram-contrast": "node --import tsx scripts/audit-diagram-contrast.ts",
    "check:nullable-upserts": "node scripts/check-null-assignment-upserts.mjs",
    "typecheck": "tsc --noEmit",
    "db:seed": "npm run db:seed:base",
    "db:seed:base": "npm run db:seed:users && npx tsx prisma/seed-personal-content.ts && npx tsx prisma/seed-spanish-guides.ts && npx tsx prisma/seed-spanish-games.ts && npx tsx prisma/seed-achievements.ts",
    "db:reset:clean": "POSTGRES_URL=${POSTGRES_URL:-$DATABASE_URL}; POSTGRES_URL=${POSTGRES_URL:-$STORAGE_POSTGRES_URL}; POSTGRES_URL=${POSTGRES_URL:-$STORAGE_PRISMA_DATABASE_URL}; export POSTGRES_URL; npx tsx prisma/seed-clean-reset.ts && npm run db:seed:base",
    "db:seed:spanish-games": "npx tsx prisma/seed-spanish-games.ts",
    "db:seed:minimal-pairs": "npx tsx prisma/seed-minimal-pairs.ts",
    "db:seed:spanish": "npx tsx prisma/seed-spanish-guides.ts",
    "db:seed:users": "POSTGRES_URL=${POSTGRES_URL:-$DATABASE_URL}; POSTGRES_URL=${POSTGRES_URL:-$STORAGE_POSTGRES_URL}; POSTGRES_URL=${POSTGRES_URL:-$STORAGE_PRISMA_DATABASE_URL}; export POSTGRES_URL; npx tsx prisma/seed-users-only.ts",
    "db:seed:vocab": "node scripts/update-all-vocab.js && node scripts/create-vocab-games.js",
    "db:seed:weekly-vocab": "node scripts/seed-weekly-vocab.js",
    "db:seed:quizzes": "npm run import:countable-uncountable && npm run import:verb-quizzes",
    "db:backup:safe": "npx tsx scripts/db/backup-database-safe.ts",
    "db:backup:check": "npx tsx scripts/check-backups.ts",
    "db:migrate": "prisma migrate deploy",
    "import:simple-tenses": "node scripts/import-simple-tenses.mjs",
    "import:countable-uncountable": "npx tsx scripts/import/import-countable-uncountable-game.ts",
    "import:verb-quizzes": "npx tsx scripts/import/import-verb-quizzes.ts",
    "import:time-indicators": "npx tsx scripts/import/import-time-indicators-game.ts",
    "delete:verb-quizzes": "npx tsx scripts/import/delete-verb-quizzes.ts",
    "audio:minimal-pairs": "npx tsx scripts/generate-minimal-pairs-audio.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@vercel/analytics": "^1.6.1",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.23.25",
    "lucide-react": "^0.556.0",
    "next": "16.0.7",
    "next-auth": "^4.24.13",
    "node-html-parser": "^6.1.13",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^2.15.0",
    "sanitize-html": "^2.14.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.4",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
