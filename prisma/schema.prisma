generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id                    String               @id @default(cuid())
  username              String               @unique
  name                  String?
  password              String
  mustChangePassword    Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  avatar                String?
  avatarColor           String?
  activityProgress      ActivityProgress[]
  calendarEventsCreated CalendarEvent[]
  ownedClasses          Class[]              @relation("ClassOwner")
  quizResponses         QuizResponse[]
  speakingSubmissions   SpeakingSubmission[]
  spotifyConnection     SpotifyConnection?
  submissions           Submission[]
  utilitySubjectStates  UtilitySubjectState[]

  healthTrackers        HealthTracker[]
  bpReadings            BloodPressureReading[]
  momentTrackers        MomentTracker[]
  workspaceContext      WorkspaceContext?
  threads               Thread[]
}

model Class {
  id             String            @id @default(cuid())
  name           String
  description    String?
  announcement   String?
  ownerId        String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  assignments    Assignment[]
  calendarEvents CalendarEvent[]
  owner          User              @relation("ClassOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
}

model SpotifyConnection {
  id            String   @id @default(cuid())
  userId        String   @unique
  spotifyUserId String
  displayName   String?
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([spotifyUserId])
  @@index([expiresAt])
}

model Activity {
  id                  String               @id @default(cuid())
  title               String
  description         String?
  type                String
  category            String?
  level               String?
  content             String
  createdBy           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  ui                  String?
  isReleased          Boolean              @default(false)
  progress            ActivityProgress[]
  assignments         Assignment[]
  quizResponses       QuizResponse[]
  speakingSubmissions SpeakingSubmission[]
  submissions         Submission[]
  threadActivities    ThreadActivity[]

  @@index([isReleased])
  @@index([type, category, isReleased])
  @@index([deletedAt])
}

model ActivityProgress {
  id           String      @id @default(cuid())
  userId       String
  activityId   String
  progress     Int         @default(0)
  status       String      @default("in_progress")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  categoryData String?
  assignmentId String?
  activity     Activity    @relation(fields: [activityId], references: [id], onDelete: Restrict)
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId, assignmentId])
}

model SpeakingSubmission {
  id                       String      @id @default(cuid())
  userId                   String
  activityId               String
  assignmentId             String?
  selectedPromptIds        String[]
  soloSentences            String[]
  soloFollowUpQuestions    String[]
  soloCompletedStepIds     String[]
  speakingBestSentence     String
  speakingCompletedStepIds String[]
  submittedAt              DateTime    @default(now())
  status                   String      @default("submitted")
  activity                 Activity    @relation(fields: [activityId], references: [id], onDelete: Restrict)
  assignment               Assignment? @relation(fields: [assignmentId], references: [id])
  user                     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId, assignmentId])
}

model Assignment {
  id                  String               @id @default(cuid())
  classId             String
  activityId          String
  title               String?
  instructions        String?
  dueDate             DateTime?
  isFeatured          Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  activityProgress    ActivityProgress[]
  activity            Activity             @relation(fields: [activityId], references: [id], onDelete: Restrict)
  class               Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  quizResponses       QuizResponse[]
  speakingSubmissions SpeakingSubmission[]
  submissions         Submission[]

  @@index([classId])
  @@index([isFeatured])
  @@index([dueDate])
}

model Submission {
  id            String      @id @default(cuid())
  userId        String
  activityId    String
  assignmentId  String?
  content       String
  score         Int?
  feedback      String?
  status        String      @default("pending")
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  activity      Activity    @relation(fields: [activityId], references: [id], onDelete: Restrict)
  assignment    Assignment? @relation(fields: [assignmentId], references: [id])
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId, assignmentId])
  @@index([userId])
  @@index([status])
  @@index([assignmentId])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  type        String    @default("holiday")
  classId     String
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  class       Class     @relation(fields: [classId], references: [id])
  createdBy   User?     @relation(fields: [createdById], references: [id])
}

model QuizResponse {
  id           String      @id @default(cuid())
  userId       String
  activityId   String
  assignmentId String?
  questionId   String
  userAnswer   String
  isCorrect    Boolean
  skillTag     String?
  difficulty   String?
  topic        String?
  createdAt    DateTime    @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity   Activity    @relation(fields: [activityId], references: [id], onDelete: Restrict)
  assignment Assignment? @relation(fields: [assignmentId], references: [id])

  @@index([userId])
  @@index([activityId])
  @@index([skillTag])
  @@index([userId, activityId])
  @@index([activityId, skillTag])
}

model UtilitySubjectState {
  id         String   @id @default(cuid())
  userId     String
  subjectKey String
  checklist  Json
  links      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectKey])
  @@index([userId])
  @@index([subjectKey])
}

// ============================================
// Health Tracking System
// ============================================

model HealthTracker {
  id        String               @id @default(cuid())
  userId    String
  name      String
  emoji     String?
  type      String               // "boolean" | "number"
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  entries   HealthTrackerEntry[]

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HealthTrackerEntry {
  id         String        @id @default(cuid())
  trackerId  String
  dateKey    String        // "YYYY-MM-DD"
  valueBool  Boolean?      // used if type="boolean"
  valueNum   Float?        // used if type="number"
  recordedAt DateTime      @default(now())

  tracker    HealthTracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)

  @@unique([trackerId, dateKey])
}

model BloodPressureReading {
  id         String   @id @default(cuid())
  userId     String
  systolic   Int
  diastolic  Int
  note       String?
  recordedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
}

model MomentTracker {
  id        String          @id @default(cuid())
  userId    String
  name      String
  emoji     String?
  unit      String?         // e.g. "Control Level (1-10)"
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  readings  MomentReading[]

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model MomentReading {
  id         String        @id @default(cuid())
  trackerId  String
  value      Float?
  note       String?
  recordedAt DateTime      @default(now())

  tracker    MomentTracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  @@index([trackerId, recordedAt])
}

model WorkspaceContext {
  id              String   @id @default(cuid())
  userId          String   @unique
  lastTool        String?
  lastEditedAt    DateTime @updatedAt
  lastDateKey     String?
  lastProjectId   String?
  recentCaptures  Json
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// Threads - Weaving Loom for Managing Attention
// ============================================

model Thread {
  id               String           @id @default(cuid())
  userId           String
  title            String           // max 100 chars
  description      String?          // optional, max 280 chars
  emoji            String?          // optional emoji identifier
  color            String           @default("sakura") // sakura|mint|amethyst|teal|rose|slate
  status           String           @default("active") // active|resting|archived
  order            Int              @default(0)
  anchorX          Float            @default(0.5) // 0-1 position on loom bar (deprecated - kept for backward compatibility)
  isCore           Boolean          @default(false) // core threads are foundational, others weave around them
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  lastFocused      DateTime?        // when moved to active
  lastRested       DateTime?        // when moved to resting

  // NEW: Gamification fields
  focusStreak      Int              @default(0) // Days of consecutive activity
  lastActivityDate DateTime?        // Last date an activity was completed
  xp               Int              @default(0) // Thread experience points

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities       ThreadActivity[]

  @@index([userId, status])
  @@index([userId, order])
}

// ============================================
// Thread Activity Linking - Connects threads to learning activities
// ============================================

model ThreadActivity {
  id         String   @id @default(cuid())
  threadId   String
  activityId String
  createdAt  DateTime @default(now())

  thread     Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([threadId, activityId])
  @@index([threadId])
  @@index([activityId])
}
