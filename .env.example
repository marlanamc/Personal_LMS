# Database
# Local development: a plain direct connection is fine.
POSTGRES_URL="postgresql://user:password@localhost:5432/personal_lms_db"
#
# Production / serverless (Vercel): use a POOLED connection string so concurrent
# lambda invocations don't exhaust Postgres `max_connections`. Prisma reads
# POSTGRES_PRISMA_URL first (Vercel Postgres sets this automatically to its
# pgbouncer-pooled endpoint). If you supply your own pooled URL, include the
# pgbouncer + connection_limit query params, e.g.:
# POSTGRES_PRISMA_URL="postgresql://user:password@host:6543/db?pgbouncer=true&connection_limit=10"
# Migrations need a DIRECT (non-pooled) connection:
# POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/db"

# NextAuth Configuration
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# For production (Vercel), set these in your Vercel project settings:
# POSTGRES_URL - Your PostgreSQL database URL
# NEXTAUTH_SECRET - A secure random string (use: openssl rand -base64 32)
# NEXTAUTH_URL - Your production URL (e.g., https://your-app.vercel.app)

CRON_SECRET="your-vercel-cron-secret-here"

# Optional: Upstash Redis for API rate limiting
UPSTASH_REDIS_REST_URL="https://your-upstash-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Optional: ElevenLabs TTS (for pronunciation/minimal-pairs audio generation scripts)
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# Optional: backup encryption key for scripts/db/backup-database-safe.ts
BACKUP_ENCRYPTION_KEY="a-long-random-secret-for-backup-encryption"

# Optional: Spotify timer integration
SPOTIFY_CLIENT_ID="your-spotify-app-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-app-client-secret"
# Optional override. Must exactly match a Spotify App Redirect URI (including protocol + host).
# Recommended in production to avoid callback mismatches across preview/custom domains.
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/spotify/callback"
